        </mxCell>
        <mxCell id="XKRq_j1yvkZFjiNEO7QI-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;## STUDENT&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;### A. Research Entry Workflow (sequential)&lt;/div&gt;&lt;div&gt;```&lt;/div&gt;&lt;div&gt;( Start )&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; │&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; ▼&lt;/div&gt;&lt;div&gt;[ Log in ]&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; │&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; ▼&lt;/div&gt;&lt;div&gt;[ Open &quot;My Research&quot; tab → find draft pre-created by adviser ]&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; │&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; ▼&lt;/div&gt;&lt;div&gt;[ Fill in research details: title, abstract, manuscript,&lt;/div&gt;&lt;div&gt;&amp;nbsp; approval sheet, keywords, Agenda/SDG/SRIG ]&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; │&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; ▼&lt;/div&gt;&lt;div&gt;[ Submit for review ]&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; │&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; ▼&lt;/div&gt;&lt;div&gt;&amp;lt; Adviser approves? &amp;gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; │&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; ├── No, needs fixes ──► [ Revise entry ] ──┐&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; │&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; │&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; │&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ◄───────────────────────────────────┘&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; │&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; (loops back to &quot;Submit for review&quot; as many times as needed)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; │&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; └── Yes ──► [ Entry published — now public ]&lt;/div&gt;&lt;div&gt;```&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;### B. Other things a Student can do (independent — not in sequence)&lt;/div&gt;&lt;div&gt;```&lt;/div&gt;&lt;div&gt;Once logged in, a Student can, at any time and in any order:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp;[ Browse / search all published research&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;— by title, keyword, adviser, program, or year ]&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp;[ View &quot;My Research&quot; tab&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;— see the status of every entry where they&#39;re a listed researcher:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;Draft / Submitted / Returned for Revision / Published ]&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp;[ View faculty profiles ]&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp;[ Add a new keyword while tagging their own research&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;— creates it if it doesn&#39;t exist yet ]&lt;/div&gt;&lt;div&gt;```&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;---&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="712.5" width="1160" x="610" y="-30" as="geometry" />
        </mxCell>
        <mxCell id="XKRq_j1yvkZFjiNEO7QI-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#60a917;fontColor=#ffffff;strokeColor=#2D7600;" value="Apil &#39;My Research&#39; Ban, bahalag wala pa na integrate sa system" vertex="1">
          <mxGeometry height="100" width="190" x="740" as="geometry" />
        </mxCell>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    A[Faculty creates research entry&lt;br/&gt;Status: Draft] --&gt; B{Faculty sends&lt;br/&gt;Invite Researchers}\n    B --&gt;|Invitation sent| C[Status: Draft Invited]\n    C --&gt; D{Student receives&lt;br/&gt;invitation}\n    D --&gt;|Invalid or expired link| E[Invalid-invitation message&lt;br/&gt;No access granted]\n    D --&gt;|Valid link| F[Student signs in /&lt;br/&gt;completes account setup]\n    F --&gt; G[Student accepts invitation&lt;br/&gt;researchers.user_id linked]\n    G --&gt; H[Student opens research&lt;br/&gt;from invitation or My Research]\n    H --&gt; I[Student edits permitted&lt;br/&gt;research metadata]\n    I --&gt;|Cannot edit| I1[Program, Adviser, Research ID,&lt;br/&gt;Uploader, Researcher list, Lead Author]\n    I --&gt; J{Student submits&lt;br/&gt;for review}\n    J --&gt;|Submit| K[Status: Submitted for Review]\n    K --&gt; L[Student view only&lt;br/&gt;sees review-status message&lt;br/&gt;in My Research]\n    L --&gt; M{Faculty decision}\n    M --&gt;|Returns for revision| N[Status: Returned for Revision]\n    M --&gt;|Posts as complete| O[Status: Posted]\n    N --&gt; P[Student can edit again]\n    P --&gt; J\n    O --&gt; Q[Student sees Posted entry&lt;br/&gt;in My Research, view only]\n\n    style E fill:#f8d7da,stroke:#c00\n    style K fill:#fff3cd,stroke:#c90\n    style O fill:#d4edda,stroke:#0a0\n    style Q fill:#d4edda,stroke:#0a0\n    style I1 fill:#f8d7da,stroke:#c00&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="DCvLOTZWO3EQyACqnEeX-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontSize=17;fontStyle=1" vertex="1">
